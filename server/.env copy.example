# Copy this file to .env and fill in your values:
#   copy .env.example .env

PORT=5000
CLIENT_URL=http://localhost:3000

# Local MongoDB (database name: volumedaytrader)
MONGODB_URI=mongodb://127.0.0.1:27017/volumedaytrader

# MongoDB Atlas example (replace user, password, cluster):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/volumedaytrader
