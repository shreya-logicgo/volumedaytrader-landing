{
  "info": {
    "_postman_id": "vdt-auth-collection-001",
    "name": "Volume Day Trader API",
    "description": "All backend APIs: Health, Auth, Inquiries.\n\nImport → set `baseUrl`, `adminEmail`, `adminPassword` → run **Login** → protected routes use `{{token}}` automatically.\n\nDocs: server/docs/AUTH_API.md · server/docs/INQUIRY_API.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": "volumedaytrader@yopmail.com"
    },
    {
      "key": "adminPassword",
      "value": "Volumedaytrader123"
    },
    {
      "key": "resetToken",
      "value": ""
    },
    {
      "key": "resetSecret",
      "value": "your-ADMIN_RESET_SECRET"
    },
    {
      "key": "lastTicketNumber",
      "value": ""
    },
    {
      "key": "inquiryFirstName",
      "value": "John"
    },
    {
      "key": "inquiryLastName",
      "value": "Doe"
    },
    {
      "key": "inquiryEmail",
      "value": "john@example.com"
    },
    {
      "key": "inquiryPhone",
      "value": "1234567890"
    },
    {
      "key": "inquiryMessage",
      "value": "I would like more information about your indicators."
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Check API and database connection."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "  }",
                  "  if (json.admin && json.admin.email) {",
                  "    pm.collectionVariables.set('adminEmail', json.admin.email);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Returns JWT token. Saves `token` to collection variables on success."
          }
        },
        {
          "name": "Get Me (current admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Protected route. Requires Bearer token from Login."
          }
        },
        {
          "name": "Change Password (logged in)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{adminPassword}}\",\n  \"newPassword\": \"NewPassword1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "change-password"]
            },
            "description": "Admin knows old password. PATCH + Bearer token. Not for forgot-password link."
          }
        },
        {
          "name": "Forgot Password (send email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "forgot-password"]
            },
            "description": "Sends reset email if admin exists. 404 if email not registered. Copy token from email URL into `resetToken` variable."
          }
        },
        {
          "name": "Reset Password (from email token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"NewPassword1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "reset-password"]
            },
            "description": "POST (not PATCH). Uses token from forgot-password email. No Bearer auth."
          }
        },
        {
          "name": "Reset Password Emergency (optional)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"resetSecret\": \"{{resetSecret}}\",\n  \"newPassword\": \"NewPassword1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/reset-password-emergency",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "reset-password-emergency"]
            },
            "description": "Requires ADMIN_RESET_SECRET in server .env. Not for admin UI."
          }
        }
      ]
    },
    {
      "name": "Inquiries",
      "description": "Contact form / tickets — POST public, GET admin (Bearer JWT).",
      "item": [
        {
          "name": "1. Submit inquiry (public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.ticketNumber) {",
                  "    pm.collectionVariables.set('lastTicketNumber', json.ticketNumber);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"{{inquiryFirstName}}\",\n  \"lastName\": \"{{inquiryLastName}}\",\n  \"email\": \"{{inquiryEmail}}\",\n  \"phone\": \"{{inquiryPhone}}\",\n  \"message\": \"{{inquiryMessage}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/inquiries",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inquiries"]
            },
            "description": "POST /api/inquiries — no auth. Creates ticket + sends emails. Expect 201."
          }
        },
        {
          "name": "2. List all inquiries (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.test('Has inquiries array', function () {",
                  "    pm.expect(json.inquiries).to.be.an('array');",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inquiries",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inquiries"]
            },
            "description": "GET /api/inquiries — Bearer JWT. Run Login first. Expect 200 with count + inquiries."
          }
        }
      ]
    }
  ]
}
